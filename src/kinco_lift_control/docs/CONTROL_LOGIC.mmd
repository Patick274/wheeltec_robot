%% 2026-11-04 当前源码流程,与6页PPT配套
%% 原始基线acf01fb,包含本轮holding监测修复
flowchart TD
    S([启动 lift]) --> R["加载配置并只读反馈"]
    R --> Q{"收到显式运动请求?"}
    Q -- 否 --> R
    Q -- 是 --> G{"门禁 / 底盘健康 / 预算 / 坐标条件满足?"}
    G -- 否 --> REJ["回绝请求,保留已有会话"]
    G -- 是 --> E["正式使能握手及节点保护"]
    E --> MODE{"显式选择模式"}
    MODE -- 速度模式3 --> K["方向键心跳与方向限位检查"]
    K --> V["60FF速度 / 方向相关速度区"]
    MODE -- 位置模式1 --> H["升长量或顶端总高度 H"]
    H --> T["目标计数 = 参考 + 升长量换算"]
    T --> POS["607A目标 / 6081速度"]
    V --> POLL["读取真实反馈,检查故障 / 模式 / 限位 / 超时"]
    POS --> POLL
    POLL -- 正常 --> DONE{"达到任务停止条件?"}
    DONE -- 否 --> POLL
    DONE -- 是 --> IDLE["停稳完成或保留使能暂停"]
    POLL -- 真实异常 --> FAIL["快停锁存,撤参考与旧目标"]
    FAIL --> INSPECT["现场检查后显式复位和重新建参考"]

    subgraph B["底盘低速许可"]
      CMD["底盘运动意图"] --> REQ["20Hz带号请求"]
      REQ --> CAP["升降保留100rpm上限"]
      CAP --> SPEED{"实际和命令都不超过100rpm?"}
      SPEED -- 否 --> WAIT["底盘保持零速并等待"]
      SPEED -- 是 --> PERMIT["升降返回相同序号许可"]
      PERMIT --> FRESH{"许可 / 指令 / 反馈新鲜?"}
      FRESH -- 是 --> SERIAL["底盘最终串口非零输出"]
      FRESH -- 否 --> ZERO["最终串口零速"]
    end

    subgraph U["显式上端释放,不扩大软件行程"]
      U0["只有上限位有效,底盘静止,帧可信"] --> U1["starting:正式使能与guard"]
      U1 --> U2["descending:默认50rpm,最多10s/20mm"]
      U2 --> U3{"开关释放且回到正常范围?"}
      U3 -- 否且未超限 --> U2
      U3 -- 是 --> U4["halting:写零速度并确认停稳"]
      U4 --> U5["holding:保留使能和guard"]
      U5 --> U6["速度正负对称去抖0.5s,位置漂移立即监测"]
      U6 --> U7["显式disable后再确认参考和模式"]
      U2 -- 异常 --> FAIL
      U5 -- 异常 --> FAIL
      PAUSE["重复暂停 / 键盘中立"] --> KEEP["保持锚点与去抖时钟不重置"]
      KEEP --> U5
    end

    subgraph X["进程或通信失效"]
      DEAD["SIGKILL / 断电 / 断链"] --> NOHOOK["Python清理可能无法运行"]
      NOHOOK --> GUARD["驱动器独立节点保护超时"]
      GUARD --> DRIVE["按驱动器策略停车并记录故障"]
    end
