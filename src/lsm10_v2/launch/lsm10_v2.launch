<launch>
	<arg name="if_double" default="true"/>
    <node unless="$(arg if_double)" name="lsm10_v2" pkg="lsm10_v2" type="lsm10_v2" output="screen">
        <param name="scan_topic" value="scan_double_m10"/>         <!--设置激光数据topic名称-->
        <param name="frame_id" type="string" value="laser"/>     <!--激光坐标-->
        <param name="serial_port" value="/dev/wheeltec_lidar1"/>  <!--雷达连接的串口-->
        <param name="baud_rate" value="460800" />        <!--雷达连接的串口波特率-->
    </node>

    <node if="$(arg if_double)" name="lsm10_v2_1" pkg="lsm10_v2" type="lsm10_v2" output="screen">
        <param name="scan_topic" value="scan1"/>         <!--设置激光数据topic名称-->
        <param name="frame_id" type="string" value="laser1"/>     <!--激光坐标-->
        <param name="serial_port" value="/dev/wheeltec_lidar1"/>  <!--雷达连接的串口-->
        <param name="baud_rate" value="460800" />        <!--雷达连接的串口波特率-->
        <param name="truncated_mode" value="1"/>    <!--0:不使用过滤 1:使用过滤-->
        <param name="min_distance" type="double" value="0"/> <!--最小扫描距离-->
        <param name="max_distance" type="double" value="30"/> <!--最大扫描距离-->
        <rosparam param="disable_min">[100]</rosparam> <!--角度左值-->
        <rosparam param="disable_max">[260]</rosparam> <!--角度右值-->
    </node>

    <node if="$(arg if_double)" name="lsm10_v2_2" pkg="lsm10_v2" type="lsm10_v2" output="screen">
        <param name="scan_topic" value="scan2"/>         <!--设置激光数据topic名称-->
        <param name="frame_id" type="string" value="laser2"/>     <!--激光坐标-->
        <param name="serial_port" value="/dev/wheeltec_lidar2"/>  <!--雷达连接的串口-->
        <param name="baud_rate" value="460800" />        <!--雷达连接的串口波特率-->
        <param name="truncated_mode" value="1"/>    <!--0:不使用过滤 1:使用过滤-->
        <param name="min_distance" type="double" value="0"/> <!--最小扫描距离-->
        <param name="max_distance" type="double" value="30"/> <!--最大扫描距离-->
        <rosparam param="disable_min">[100]</rosparam> <!--角度左值-->
        <rosparam param="disable_max">[260]</rosparam> <!--角度右值-->
    </node>

    <node if="$(arg if_double)" name="lsm10_v2_double" pkg="lsm10_v2" type="lsm10_v2_double" >
        <param name="scan_topic" value="/scan"/>    <!--scan_double_m10设置激光数据topic名称--><!--如果要加入c16雷达，将单线雷达的topic换为scan_double_m10-->
        <param name="frame_id"         type="string" value="laser"/>
        <param name="lidar1_rotate"    type="double"   value="180"/>           <!-- 雷达1坐标旋转角度-->
        <param name="lidar2_rotate"    type="double"   value="0"/>           <!-- 雷达2坐标旋转角度-->
        <param name="lidar1_xoffset"   type="double"   value="0.3"/>      <!-- 雷达1坐标原点x轴偏移距离-->
        <param name="lidar2_xoffset"   type="double"   value="-0.3"/>       <!-- 雷达2坐标原点x轴偏移距离-->
        <param name="lidar1_yoffset"   type="double"   value="0"/>           <!-- 雷达1坐标原点y轴偏移距离-->
        <param name="lidar2_yoffset"   type="double"   value="0"/>           <!-- 雷达2坐标原点y轴偏移距离-->
    </node>
</launch>

