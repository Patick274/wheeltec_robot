<launch>
  <arg name="configuration_directory" default="$(find turn_on_wheeltec_robot)/configuration_files"/>
  <arg name="configuration_basename"  default="wheeltec_2d.lua"/>

  <!-- cartographer 主节点:消费合并后的 /scan、/odom、/imu,发布 map->odom_combined TF -->
  <node name="cartographer_node" pkg="cartographer_ros" type="cartographer_node" output="screen"
        args="-configuration_directory $(arg configuration_directory)
              -configuration_basename $(arg configuration_basename)">
    <remap from="scan" to="scan"/>
    <remap from="odom" to="odom"/>
    <remap from="imu"  to="imu"/>
  </node>

  <!-- 栅格地图节点:发布 /map 供 rviz 显示与 map_saver 保存 -->
  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node" output="screen"
        args="-resolution 0.05 -publish_period_sec 1.0"/>
</launch>
