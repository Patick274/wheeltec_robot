<launch>
  <!-- Arguments参数 -->
  <arg name="car_mode"  default="" />

  <!-- 用于robot_state_publisher节点-->
  <!-- senior_wheeltec 车型的 base_footprint→base_link 已由新 URDF 的 base_footprint_joint 提供，此处不再重复发布 -->
  <group unless="$(eval car_mode == 'senior_wheeltec')">
    <node pkg="tf" type="static_transform_publisher" name="base_to_link" args="0 0 0 0 0 0 base_footprint base_link 100" />
  </group>

  <!-- ================= 车型 TF (static transform) ================= -->
  <!-- car_mode and tf  senior_wheeltec (本车: 新 SolidWorks 模型) -->
  <!-- 本车无摄像头；gyro_link 由新 URDF 的 gyro_joint 提供。
       融合帧 laser 是 laser1+laser2 融合结果：x/y 已在 lsm10_double 节点内部补偿到车体中心，
       旋转也已补偿；故挂到 base_link 下与 laser1/laser2 平级，只给高度 0.035（同 laser1/laser2 高度），
       不能再加 x/y 偏移或 yaw 旋转 -->
  <group if="$(eval car_mode == 'senior_wheeltec')">
      <node pkg="tf" type="static_transform_publisher" name="base_to_laser" args="0 0 0.035 0 0 0  base_link laser 100" />
  </group>

  
  <!-- car_mode and tf  senior_diff-->
  <group if="$(eval car_mode == 'senior_diff')">
      <node pkg="tf" type="static_transform_publisher" name="base_to_laser" args="0.23 0.00 0.20 3.14 0 0  base_footprint laser 100" />
      <node pkg="tf" type="static_transform_publisher" name="base_to_camera" args="0.29 0.00 0.15 0 0 0   base_footprint camera_link 100" />
      <node pkg="tf" type="static_transform_publisher" name="base_to_gyro" args="0 0 0 0 0 0 base_footprint gyro_link 100" />
  </group>

  <!-- car_mode and tf  six_wheel_with_lebai-->
  <group if="$(eval car_mode == 'six_wheel_with_lebai')">
      <node pkg="tf" type="static_transform_publisher" name="base_to_laser3" args="0 0 0.85 5.5 0 0  base_footprint laser3 100" />
      <node pkg="tf" type="static_transform_publisher" name="base_to_laser" args="0 0 0.19 3.14 0 0  base_footprint laser 100" /><!--laser-->
      <node pkg="tf" type="static_transform_publisher" name="base_to_laser1" args="-0.33 0 0.19 0 0 0  base_footprint laser1 100" /><!--laser1 -->
      <node pkg="tf" type="static_transform_publisher" name="base_to_laser2" args="0.33 0 0.19 3.14 0 0  base_footprint laser2 100" /><!--laser2 -->
      <!--<node pkg="tf" type="static_transform_publisher" name="base_to_astra" args="0.035 0.00 0.55 0 0 0   base_footprint camera_link 100" />-->
      <node pkg="tf" type="static_transform_publisher" name="base_to_astra" args="0.035 0.00 0.55 0 0 0   base_footprint astra 100" />
      <node pkg="tf" type="static_transform_publisher" name="base_to_gyro" args="0 0 0 0 0 0 base_footprint gyro_link 100" />
  </group>

  <!-- ================= URDF 标准化机器人描述 ================= -->
  <group if="$(eval car_mode == 'senior_wheeltec')">
      <param name = "robot_description" textfile = "$(find wheeltec_robot)/urdf/wheeltec_robot.urdf"/>
  </group>
  <group if="$(eval car_mode == 'senior_diff')">
      <param name = "robot_description" textfile = "$(find turn_on_wheeltec_robot)/urdf/senior_diff_robot.urdf"/>
  </group>
  <group if="$(eval car_mode == 'six_wheel_with_lebai')">
      <param name="robot_description" command="$(find xacro)/xacro '$(find turn_on_wheeltec_robot)/urdf/six_wheel_with_lebai/six_wheel_with_lebai.xacro'" />
  </group>

  <!-- 读取urdf信息(robot_description) 发布话题：/joint_states-->
  <node unless="$(eval car_mode == 'six_wheel_with_lebai')" name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />

  <!-- 订阅话题：/joint_states，发布小车TF信息-->
  <node unless="$(eval car_mode == 'six_wheel_with_lebai')" name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
  <node if="$(eval car_mode == 'six_wheel_with_lebai')" name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <!-- <remap from="/joint_states" to="/wheeltec/joint_states"/> -->
  </node>

 </launch>
