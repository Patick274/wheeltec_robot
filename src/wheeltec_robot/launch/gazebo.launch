<launch>
  <include
    file="$(find gazebo_ros)/launch/empty_world.launch" />
  <param
    name="robot_description"
    textfile="$(find wheeltec_robot)/urdf/wheeltec_robot.urdf" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="spawn_model"
    pkg="gazebo_ros"
    type="spawn_model"
    args="-file $(find wheeltec_robot)/urdf/wheeltec_robot.urdf -urdf -model wheeltec_robot"
    output="screen" />
  <node
    name="fake_joint_calibration"
    pkg="rostopic"
    type="rostopic"
    args="pub /calibrated std_msgs/Bool true" />
</launch>
